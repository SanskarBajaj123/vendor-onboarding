{
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/vendors/:path*",   "destination": "/api/index.py" },
    { "source": "/employees/:path*", "destination": "/api/index.py" },
    { "source": "/verify/:path*",    "destination": "/api/index.py" },
    { "source": "/health",           "destination": "/api/index.py" },
    { "source": "/(.*)",             "destination": "/index.html" }
  ]
}
